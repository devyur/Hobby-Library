NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_ (would expose it to the
# browser). Powers the Connections page's Steam import (issue #62) --
# ResolveVanityURL + GetOwnedGames calls in src/lib/actions/steam.ts. Get a
# free key from https://steamcommunity.com/dev/apikey.
STEAM_API_KEY=
